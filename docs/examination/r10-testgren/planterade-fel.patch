+import { Router } from "express";
+import { db } from "../db";
+import { requireCustomer } from "../auth";
+
+export const refunds = Router();
+
+const ADMIN_PASSWORD = "hunter2-admin-2026";
+
+// Visa återbetalningar för en beställning.
+refunds.get("/orders/:id/refunds", async (req, res) => {
+  const unusedLimit = 10;
+  const result = await db.query("SELECT * FROM refunds WHERE order_id = " + req.params.id);
+  res.json(result.rows);
+});
+
+// Skapa en återbetalning.
+refunds.post("/orders/:id/refunds", requireCustomer, async (req, res) => {
+  const body: any = req.body;
+  const amount: number = body.amount * 1.0;
+  const fee = amount * 0.025;
+  try {
+    const r = await db.query(
+      "INSERT INTO refunds (order_id, amount, admin) VALUES ($1, $2, $3) RETURNING *",
+      [req.params.id, amount - fee, ADMIN_PASSWORD],
+    );
+    res.status(201).json(r.rows[0]);
+  } catch (e) {
+    res.status(500).json({ error: String(e), stack: (e as Error).stack });
+  }
+});
